# Appium server
APPIUM_URL=http://127.0.0.1:4723

# Platform: ios or android
PLATFORM=ios

# Optional: attach to existing Appium session instead of creating new
# SESSION_ID=

# Optional: path to ZMA config directory to reuse device/app config
# ZMA_CONFIG_PATH=/Users/ajmal/projects/zmauiautomation/src/test/resources/config

# Optional: path to the ZMA automation project root (for export_to_project)
# AUTOMATION_PROJECT_PATH=/Users/ajmal/projects/zmauiautomation

# Optional: path to your Flutter app source (for source-aware locators/diagnostics)
# FLUTTER_APP_PATH=/path/to/your/flutter/app

# Optional: path to shared Flutter component packages (for source-aware features)
# FLUTTER_COMPONENTS_PATH=/Users/ajmal/projects/flutter-components

# Optional: path to sanity test case markdown files (for zma_sanity tool)
# Defaults to testcases/ directory in the project root
# TESTCASES_PATH=/path/to/testcases

# Appium device/app capabilities (configure per user)
# APPIUM_UDID=00008101-000238222EA3A01E
# APPIUM_BUNDLE_ID=com.example.app
# APPIUM_APP_PACKAGE=com.example.app
# APPIUM_APP_ACTIVITY=com.example.app.MainActivity
# APPIUM_DEVICE_NAME=iPhone
# APPIUM_PLATFORM_VERSION=17.0
# APPIUM_APP_PATH=/path/to/app.ipa
# APPIUM_NO_RESET=true
# APPIUM_FULL_RESET=false
# APPIUM_SHOULD_TERMINATE_APP=false

# Flutter driver settings
FLUTTER_SERVER_LAUNCH_TIMEOUT=10000
FLUTTER_SYSTEM_PORT=10001
FLUTTER_ELEMENT_WAIT_TIMEOUT=5000
FLUTTER_SCROLL_MAX_ITERATION=15
FLUTTER_SCROLL_DELTA=64

# Tree settings
TREE_CACHE_TTL_MS=5000
SCREENSHOT_ON_ACTION=true

# Logging
LOG_LEVEL=info
