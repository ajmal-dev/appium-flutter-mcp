{
  "name": "qa-mcp-appium",
  "version": "1.0.0",
  "description": "MCP server for driving Flutter hybrid apps via Appium Flutter Integration Driver",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "qa-mcp-appium": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "setup": "tsx scripts/setup-mcp.ts",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "inspect:web": "tsx src/inspector-web/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@xmldom/xmldom": "^0.9.9",
    "dotenv": "^16.4.7",
    "webdriverio": "^9.14.0",
    "winston": "^3.17.0",
    "ws": "^8.20.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/electron": "^1.4.38",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "electron": "^41.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
